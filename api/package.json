{
  "name": "planner-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var ALLOWED_APP_URLS:http://localhost:5176/planner/ --var APP_ENV:local",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply planner --local",
    "db:migrate:remote": "node scripts/deploy.mjs --migrate-only"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "~5.7.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
